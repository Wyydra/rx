module Test

;; 1. Définition de types (Patterns)
Point = [x~int, y~int]
User  = [name~string, score~int, pos~Point]

;; 2. Initialisation de l'état de l'acteur
;; Retourne l'état initial : un record User
init = (name) {
    User[name: name, score: 0, pos: [x: 0, y: 0]]
}

;; 3. Logique de l'acteur (Macro-matching)
;; Chaque fonction on_msg prend (état_actuel, message)
;; et retourne le nouvel état.

;; Match sur un atome simple
on_msg = (s~User, #ping) {
    print("pong")
    s ;; Retourne l'état inchangé
}

;; Match structurel : mise à jour de la position
on_msg = (s~User, [#move, dx~int, dy~int]) {
    new_pos = [x: s.pos.x + dx, y: s.pos.y + dy]
    s[pos: new_pos] ;; Update fonctionnel
}

;; Utilisation du Pinning (^)
;; On ne réagit qu'aux messages venant d'un ID spécifique
on_msg = (s~User, [#reset, ^s.name]) {
    s[score: 0]
}

;; Match avec logique locale (Micro-match)
on_msg = (s~User, [#bonus, amount]) {
    match amount {
        a~int { 
            print("Adding bonus")
            s[score: s.score + a]
        }
        _ {
            print("Invalid amount")
            s
        }
    }
}

;; Catch-all
on_msg = (s, _) s

;; 4. Exemple d'appel UFCS et dualité
test_logic = () {
    ;; Construction
    p = Point[x: 10, y: 20]
    
    ;; Unboxing via pattern matching local
    [px, py] = p
    
    ;; UFCS
    p:print_pos()
}

print_pos = (p~Point) {
    print("X: " + p.x)
    print("Y: " + p.y)
}
