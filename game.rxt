(module
  (func $_start ()
    (let $game :game)
    (let $me (self))

    ; Setup main game actor - redundant now with actor-based system

    ; Spawn player actor
    (spawn $player_logic $game)
    
    ; Spawn enemy actors
    (spawn $enemy_logic $game 100 300 :red 60 0)
    (spawn $enemy_logic $game 700 100 :yellow 0 60)

    (tail_call $main_loop)
  )

  (func $main_loop ()
    (let $event (recv))
    (let $type (tuple_get $event 0))
    
    (if (eq $type :quit)
      (return 0)
    )
    
    (tail_call $main_loop)
  )

  (func $player_logic ($game)
    (print :player_starting)
    (print $game)
    (let $me (self))
    ; Register as a physical entity
    (send $game (tuple :register $me :rect 400 300 50 50 :cyan 1))
    ; Subscribe to input events
    (send $game (tuple :subscribe :input $me))

    (tail_call $player_loop $game $me)
  )

  (func $player_loop ($game $me)
    (let $msg (recv))
    (let $type (tuple_get $msg 0))

    (if (eq $type :key_down)
      (let $key (tuple_get $msg 1))
      (if (eq $key :left)  (send $game (tuple :physics $me -200 0)))
      (if (eq $key :right) (send $game (tuple :physics $me 200 0)))
      (if (eq $key :up)    (send $game (tuple :physics $me 0 -200)))
      (if (eq $key :down)  (send $game (tuple :physics $me 0 200)))
    )

    (if (eq $type :key_up)
      (send $game (tuple :physics $me 0 0))
    )

    (if (eq $type :collide)
      (send $game (tuple :shake 15))
    )

    (tail_call $player_loop $game $me)
  )

  (func $enemy_logic ($game $x $y $color $vx $vy)
    (let $me (self))
    ; register pid :rect x y w h color hitbox
    (send $game (tuple :register $me :rect $x $y 50 50 $color 1))
    (send $game (tuple :physics $me $vx $vy))

    (tail_call $enemy_loop $game $me)
  )

  (func $enemy_loop ($game $me)
    (let $msg (recv))
    (let $type (tuple_get $msg 0))

    (if (eq $type :collide)
      ; Enemies just bounce, which is already handled by C physics engine for now.
      ; But they could do logic here (e.g. change color)
      (return 0) ; Just for demo
    )

    (tail_call $enemy_loop $game $me)
  )
)
