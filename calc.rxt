(module
  (func $_start ()
    (let $me (self))

    (send :ui (tuple :draw 
      (tuple :vbox 
        (tuple :label "0" :display)
        (tuple :hbox (tuple :button "7" 7) (tuple :button "8" 8) (tuple :button "9" 9) (tuple :button "/" 14))
        (tuple :hbox (tuple :button "4" 4) (tuple :button "5" 5) (tuple :button "6" 6) (tuple :button "*" 13))
        (tuple :hbox (tuple :button "1" 1) (tuple :button "2" 2) (tuple :button "3" 3) (tuple :button "-" 12))
        (tuple :hbox (tuple :button "C" 10) (tuple :button "0" 0) (tuple :button "=" 15) (tuple :button "+" 11))
      )
      $me
    ))

    (tail_call $event_loop :ui 0 0 0 1)
  )

  ; state  = current displayed number
  ; lhs    = left-hand side stored before operator
  ; op     = 0 none | 11 + | 12 - | 13 * | 14 /
  ; new    = 1 means next digit starts a fresh number
  (func $event_loop ($ui $state $lhs $op $new)
    (let $event (recv))
    (let $type  (tuple_get $event 0))

    (if (eq $type :close)
      (return 0)
    )

    (let $id (tuple_get $event 1))

    ; ── digit 0-9 ───────────────────────────────────────────────────────────
    (if (lt $id 10)
      (if (eq $new 1)
        (send $ui (tuple :update :display $id))
        (tail_call $event_loop $ui $id $lhs $op 0)
      )
      (let $acc (add (mul $state 10) $id))
      (send $ui (tuple :update :display $acc))
      (tail_call $event_loop $ui $acc $lhs $op 0)
    )

    ; ── clear ───────────────────────────────────────────────────────────────
    (if (eq $id 10)
      (send $ui (tuple :update :display 0))
      (tail_call $event_loop $ui 0 0 0 1)
    )

    ; ── operators ───────────────────────────────────────────────────────────
    (if (eq $id 11) (tail_call $event_loop $ui $state $state 11 1))
    (if (eq $id 12) (tail_call $event_loop $ui $state $state 12 1))
    (if (eq $id 13) (tail_call $event_loop $ui $state $state 13 1))
    (if (eq $id 14) (tail_call $event_loop $ui $state $state 14 1))

    (if (eq $id 15)
      (if (eq $op 11)
        (let $res (add $lhs $state))
        (send $ui (tuple :update :display $res))
        (tail_call $event_loop $ui $res 0 0 1)
      )
      (if (eq $op 12)
        (let $res (sub $lhs $state))
        (send $ui (tuple :update :display $res))
        (tail_call $event_loop $ui $res 0 0 1)
      )
      (if (eq $op 13)
        (let $res (mul $lhs $state))
        (send $ui (tuple :update :display $res))
        (tail_call $event_loop $ui $res 0 0 1)
      )
      (if (eq $op 14)
        (let $res (div $lhs $state))
        (send $ui (tuple :update :display $res))
        (tail_call $event_loop $ui $res 0 0 1)
      )
      ; no op — just reset
      (send $ui (tuple :update :display $state))
      (tail_call $event_loop $ui $state 0 0 1)
    )

    ; ── unknown event — wait for next ────────────────────────────────────────
    (tail_call $event_loop $ui $state $lhs $op $new)
  )
)
