(module
    (func $square_loop ($vx $vy $ennemy_id)
        (let $msg (recv))
        (let $type (tuple_get $msg 0))
        (if (eq $type :quit)
            (return 0)
        )
        (if (eq $type :collide)
            (let $target (tuple_get $msg 1))
            ;; Si on touche un mur OU l'ennemi, on arrête
            (if (eq $target :wall) (return 0))
            (if (eq $target $ennemy_id) (return 0))
        )
        (if (eq $type :key_down)
            (let $key (tuple_get $msg 1))
            (let $id (self))
            (if (eq $key :left)
                (send :game (tuple :physics $id -200 0))
                (tail_call $square_loop -200 0 $ennemy_id)
            )
            (if (eq $key :right)
                (send :game (tuple :physics $id 200 0))
                (tail_call $square_loop 200 0 $ennemy_id)
            )
            (if (eq $key :up)
                (send :game (tuple :physics $id 0 -200))
                (tail_call $square_loop 0 -200 $ennemy_id)
            )
            (if (eq $key :down)
                (send :game (tuple :physics $id 0 200))
                (tail_call $square_loop 0 200 $ennemy_id)
            )
        )
        (tail_call $square_loop $vx $vy $ennemy_id)
    )

    (func $square_actor ($ennemy_id)
        (let $me (self))
        (send :game (tuple :subscribe :input $me))
        (send :game (tuple :register $me :rect 400 300 100 100 :red 1))
        (send :game (tuple :physics $me 200 0))
        (tail_call $square_loop 200 0 $ennemy_id)
    )

    (func $ennemy_loop ()
        (recv)
        (tail_call $ennemy_loop)
    )

    (func $ennemy_actor ()
        (let $me (self))
        (send :game (tuple :subscribe :input $me))
        (send :game (tuple :register $me :rect 200 200 100 100 :blue 1))
        (tail_call $ennemy_loop)
    )

    (func $_start ()
        (let $ennemy (spawn $ennemy_actor))
        (spawn $square_actor $ennemy)
    )
)